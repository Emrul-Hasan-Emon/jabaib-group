{
  "info": {
    "name": "Jabaib API \u2014 Products",
    "_postman_id": "jabaib-products-collection",
    "description": "Product CRUD, list filtering, media manager. Thumbnail/media files are uploaded first via /file/upload?folder=product.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:3000"
    },
    {
      "key": "adminAccessToken",
      "value": ""
    },
    {
      "key": "adminRefreshToken",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "Auth",
      "item": [
        {
          "name": "Admin login (sets token)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/v1/admin/auth/login",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "v1",
                "admin",
                "auth",
                "login"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"admin@jabaib.com\",\n  \"password\": \"Admin@12345\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const res = pm.response.json();",
                  "pm.collectionVariables.set('adminAccessToken', res.accessToken);",
                  "pm.collectionVariables.set('adminRefreshToken', res.refreshToken);"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "Products",
      "item": [
        {
          "name": "List",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{adminAccessToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/v1/admin/product?page=0&size=10&q=&categoryId=&collectionId=&isPublished=&isFeatured=&isActive=&sort=createdAt:desc",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "v1",
                "admin",
                "product"
              ],
              "query": [
                {
                  "key": "page",
                  "value": "0"
                },
                {
                  "key": "size",
                  "value": "10"
                },
                {
                  "key": "q",
                  "value": ""
                },
                {
                  "key": "categoryId",
                  "value": ""
                },
                {
                  "key": "collectionId",
                  "value": ""
                },
                {
                  "key": "isPublished",
                  "value": ""
                },
                {
                  "key": "isFeatured",
                  "value": ""
                },
                {
                  "key": "isActive",
                  "value": ""
                },
                {
                  "key": "sort",
                  "value": "createdAt:desc"
                }
              ]
            }
          }
        },
        {
          "name": "Get one",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{adminAccessToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/v1/admin/product/1",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "v1",
                "admin",
                "product",
                "1"
              ]
            }
          }
        },
        {
          "name": "Create",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{adminAccessToken}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/v1/admin/product",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "v1",
                "admin",
                "product"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Classic T-Shirt\",\n  \"nameBN\": \"\\u099f\\u09bf-\\u09b6\\u09be\\u09b0\\u09cd\\u099f\",\n  \"categoryId\": 1,\n  \"collectionId\": null,\n  \"isFeatured\": false,\n  \"isPublished\": true,\n  \"isActive\": true\n}"
            }
          }
        },
        {
          "name": "Update",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{adminAccessToken}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/v1/admin/product/1",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "v1",
                "admin",
                "product",
                "1"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Classic T-Shirt v2\",\n  \"isPublished\": true\n}"
            }
          }
        },
        {
          "name": "Set thumbnail (after upload)",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{adminAccessToken}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/v1/admin/product/1",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "v1",
                "admin",
                "product",
                "1"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"thumbnailUrl\": \"jabaib/product/xxx.jpg\",\n  \"thumbnailPath\": \"jabaib/product/xxx.jpg\"\n}"
            }
          }
        },
        {
          "name": "Bulk activate/deactivate",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{adminAccessToken}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/v1/admin/product/bulk/activate",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "v1",
                "admin",
                "product",
                "bulk",
                "activate"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"ids\": [\n    1,\n    2\n  ],\n  \"isActive\": false\n}"
            }
          }
        },
        {
          "name": "Delete",
          "request": {
            "method": "DELETE",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{adminAccessToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/v1/admin/product/1",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "v1",
                "admin",
                "product",
                "1"
              ]
            }
          }
        }
      ]
    },
    {
      "name": "Product media",
      "item": [
        {
          "name": "List media",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{adminAccessToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/v1/admin/product/1/media",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "v1",
                "admin",
                "product",
                "1",
                "media"
              ]
            }
          }
        },
        {
          "name": "Add media (after upload)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{adminAccessToken}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/v1/admin/product/1/media",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "v1",
                "admin",
                "product",
                "1",
                "media"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"url\": \"jabaib/product/xxx.jpg\",\n  \"path\": \"jabaib/product/xxx.jpg\",\n  \"type\": \"image\",\n  \"altText\": \"Front view\",\n  \"isPrimary\": true,\n  \"sortOrder\": 0\n}"
            }
          }
        },
        {
          "name": "Update media",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{adminAccessToken}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/v1/admin/product/1/media/1",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "v1",
                "admin",
                "product",
                "1",
                "media",
                "1"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"altText\": \"Updated alt\",\n  \"isPrimary\": true\n}"
            }
          }
        },
        {
          "name": "Delete media",
          "request": {
            "method": "DELETE",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{adminAccessToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/v1/admin/product/1/media/1",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "v1",
                "admin",
                "product",
                "1",
                "media",
                "1"
              ]
            }
          }
        }
      ]
    }
  ]
}