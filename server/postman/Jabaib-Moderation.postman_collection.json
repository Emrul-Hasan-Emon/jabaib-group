{
  "info": {
    "name": "Jabaib API — Moderation",
    "_postman_id": "jabaib-moderation-collection",
    "description": "Admin moderation: review list/detail/approve/hide/delete and the wishlist audit.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:3000"
    },
    {
      "key": "adminAccessToken",
      "value": ""
    },
    {
      "key": "adminRefreshToken",
      "value": ""
    },
    {
      "key": "userAccessToken",
      "value": ""
    },
    {
      "key": "userRefreshToken",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "Auth",
      "item": [
        {
          "name": "Admin login (sets adminAccessToken)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "http://localhost:3000/v1/admin/auth/login",
              "host": [
                "http://localhost:3000"
              ],
              "path": [
                "v1",
                "admin",
                "auth",
                "login"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"admin@jabaib.com\",\n  \"password\": \"Admin@12345\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const res = pm.response.json();",
                  "pm.collectionVariables.set('adminAccessToken', res.accessToken);",
                  "pm.collectionVariables.set('adminRefreshToken', res.refreshToken);"
                ]
              }
            }
          ]
        },
        {
          "name": "User login (sets userAccessToken)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "http://localhost:3000/v1/user/auth/login",
              "host": [
                "http://localhost:3000"
              ],
              "path": [
                "v1",
                "user",
                "auth",
                "login"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"emailOrPhone\": \"customer@example.com\",\n  \"password\": \"Secret@123\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const res = pm.response.json();",
                  "pm.collectionVariables.set('userAccessToken', res.accessToken);",
                  "pm.collectionVariables.set('userRefreshToken', res.refreshToken);"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "Reviews",
      "item": [
        {
          "name": "List (filters: isApproved, productId, userId, q)",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{adminAccessToken}}"
              }
            ],
            "url": {
              "raw": "http://localhost:3000/v1/admin/review?page=0&size=10&isApproved=&productId=&userId=&q=",
              "host": [
                "http://localhost:3000"
              ],
              "path": [
                "v1",
                "admin",
                "review"
              ],
              "query": [
                {
                  "key": "page",
                  "value": "0"
                },
                {
                  "key": "size",
                  "value": "10"
                },
                {
                  "key": "isApproved",
                  "value": ""
                },
                {
                  "key": "productId",
                  "value": ""
                },
                {
                  "key": "userId",
                  "value": ""
                },
                {
                  "key": "q",
                  "value": ""
                }
              ]
            }
          }
        },
        {
          "name": "Detail",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{adminAccessToken}}"
              }
            ],
            "url": {
              "raw": "http://localhost:3000/v1/admin/review/1",
              "host": [
                "http://localhost:3000"
              ],
              "path": [
                "v1",
                "admin",
                "review",
                "1"
              ]
            }
          }
        },
        {
          "name": "Approve / hide",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{adminAccessToken}}"
              }
            ],
            "url": {
              "raw": "http://localhost:3000/v1/admin/review/1",
              "host": [
                "http://localhost:3000"
              ],
              "path": [
                "v1",
                "admin",
                "review",
                "1"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"isApproved\": true\n}"
            }
          }
        },
        {
          "name": "Delete",
          "request": {
            "method": "DELETE",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{adminAccessToken}}"
              }
            ],
            "url": {
              "raw": "http://localhost:3000/v1/admin/review/1",
              "host": [
                "http://localhost:3000"
              ],
              "path": [
                "v1",
                "admin",
                "review",
                "1"
              ]
            }
          }
        }
      ]
    },
    {
      "name": "Wishlist",
      "item": [
        {
          "name": "List (filters: userId, productId)",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{adminAccessToken}}"
              }
            ],
            "url": {
              "raw": "http://localhost:3000/v1/admin/wishlist?page=0&size=10&userId=&productId=",
              "host": [
                "http://localhost:3000"
              ],
              "path": [
                "v1",
                "admin",
                "wishlist"
              ],
              "query": [
                {
                  "key": "page",
                  "value": "0"
                },
                {
                  "key": "size",
                  "value": "10"
                },
                {
                  "key": "userId",
                  "value": ""
                },
                {
                  "key": "productId",
                  "value": ""
                }
              ]
            }
          }
        }
      ]
    }
  ]
}