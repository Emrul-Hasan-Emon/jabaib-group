{
  "info": {
    "name": "Jabaib API — Admin Users (super_admin only)",
    "_postman_id": "jabaib-phase5-admin-users",
    "description": "Phase 5 — Admin Users. Create/edit/disable admin accounts. Routes require super_admin role.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:3000"
    },
    {
      "key": "adminAccessToken",
      "value": ""
    },
    {
      "key": "adminRefreshToken",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "Auth",
      "item": [
        {
          "name": "Admin login (sets token)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "http://localhost:3000/v1/admin/auth/login",
              "host": [
                "http://localhost:3000"
              ],
              "path": [
                "v1",
                "admin",
                "auth",
                "login"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"admin@jabaib.com\",\n  \"password\": \"Admin@12345\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const res = pm.response.json();",
                  "pm.collectionVariables.set('adminAccessToken', res.accessToken);",
                  "pm.collectionVariables.set('adminRefreshToken', res.refreshToken);"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "Admin Users",
      "item": [
        {
          "name": "List",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{adminAccessToken}}"
              }
            ],
            "url": {
              "raw": "http://localhost:3000/v1/admin/admin-user?page=0&size=10",
              "host": [
                "http://localhost:3000"
              ],
              "path": [
                "v1",
                "admin",
                "admin-user"
              ],
              "query": [
                {
                  "key": "page",
                  "value": "0"
                },
                {
                  "key": "size",
                  "value": "10"
                }
              ]
            }
          }
        },
        {
          "name": "Detail",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{adminAccessToken}}"
              }
            ],
            "url": {
              "raw": "http://localhost:3000/v1/admin/admin-user/1",
              "host": [
                "http://localhost:3000"
              ],
              "path": [
                "v1",
                "admin",
                "admin-user",
                "1"
              ]
            }
          }
        },
        {
          "name": "Create (with profile image)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{adminAccessToken}}"
              }
            ],
            "url": {
              "raw": "http://localhost:3000/v1/admin/admin-user",
              "host": [
                "http://localhost:3000"
              ],
              "path": [
                "v1",
                "admin",
                "admin-user"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Rahim Admin\",\n  \"email\": \"rahim@jabaib.com\",\n  \"password\": \"Admin@12345\",\n  \"role\": \"admin\",\n  \"isActive\": true,\n  \"imageUrl\": \"/uploads/admin/rahim.jpg\",\n  \"imagePath\": \"/uploads/admin/rahim.jpg\"\n}"
            }
          }
        },
        {
          "name": "Update (role / password / active / image)",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{adminAccessToken}}"
              }
            ],
            "url": {
              "raw": "http://localhost:3000/v1/admin/admin-user/2",
              "host": [
                "http://localhost:3000"
              ],
              "path": [
                "v1",
                "admin",
                "admin-user",
                "2"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"role\": \"editor\",\n  \"imageUrl\": \"/uploads/admin/rahim-v2.jpg\",\n  \"imagePath\": \"/uploads/admin/rahim-v2.jpg\"\n}"
            }
          }
        },
        {
          "name": "Delete (cannot delete yourself)",
          "request": {
            "method": "DELETE",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{adminAccessToken}}"
              }
            ],
            "url": {
              "raw": "http://localhost:3000/v1/admin/admin-user/:id",
              "host": [
                "http://localhost:3000"
              ],
              "path": [
                "v1",
                "admin",
                "admin-user",
                ":id"
              ]
            }
          }
        }
      ]
    }
  ]
}