{
  "info": {
    "name": "Jabaib API \u2014 Attributes",
    "_postman_id": "jabaib-attributes-collection",
    "description": "Attribute CRUD + values. Values are managed under /attributes/:id/values and /attribute-values/:id.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:3000"
    },
    {
      "key": "adminAccessToken",
      "value": ""
    },
    {
      "key": "adminRefreshToken",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "Auth",
      "item": [
        {
          "name": "Admin login (sets token)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/v1/admin/auth/login",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "v1",
                "admin",
                "auth",
                "login"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"admin@jabaib.com\",\n  \"password\": \"Admin@12345\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const res = pm.response.json();",
                  "pm.collectionVariables.set('adminAccessToken', res.accessToken);",
                  "pm.collectionVariables.set('adminRefreshToken', res.refreshToken);"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "Attributes",
      "item": [
        {
          "name": "List",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{adminAccessToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/v1/admin/attribute?page=0&size=10&q=&isActive=",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "v1",
                "admin",
                "attribute"
              ],
              "query": [
                {
                  "key": "page",
                  "value": "0"
                },
                {
                  "key": "size",
                  "value": "10"
                },
                {
                  "key": "q",
                  "value": ""
                },
                {
                  "key": "isActive",
                  "value": ""
                }
              ]
            }
          }
        },
        {
          "name": "Get one",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{adminAccessToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/v1/admin/attribute/1",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "v1",
                "admin",
                "attribute",
                "1"
              ]
            }
          }
        },
        {
          "name": "Create",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{adminAccessToken}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/v1/admin/attribute",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "v1",
                "admin",
                "attribute"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Size\",\n  \"nameBN\": \"\\u09b8\\u09be\\u0987\\u099c\"\n}"
            }
          }
        },
        {
          "name": "Update",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{adminAccessToken}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/v1/admin/attribute/1",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "v1",
                "admin",
                "attribute",
                "1"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nameBN\": \"\\u09b8\\u09be\\u0987\\u099c\",\n  \"isActive\": true\n}"
            }
          }
        },
        {
          "name": "Delete",
          "request": {
            "method": "DELETE",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{adminAccessToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/v1/admin/attribute/1",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "v1",
                "admin",
                "attribute",
                "1"
              ]
            }
          }
        }
      ]
    },
    {
      "name": "Attribute values",
      "item": [
        {
          "name": "List values",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{adminAccessToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/v1/admin/attribute/1/values",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "v1",
                "admin",
                "attribute",
                "1",
                "values"
              ]
            }
          }
        },
        {
          "name": "Add value",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{adminAccessToken}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/v1/admin/attribute/1/values",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "v1",
                "admin",
                "attribute",
                "1",
                "values"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"M\",\n  \"colorCode\": null,\n  \"sortOrder\": 0\n}"
            }
          }
        },
        {
          "name": "Update value",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{adminAccessToken}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/v1/admin/attribute-value/1",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "v1",
                "admin",
                "attribute-value",
                "1"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"L\",\n  \"colorCode\": \"#000000\"\n}"
            }
          }
        },
        {
          "name": "Delete value",
          "request": {
            "method": "DELETE",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{adminAccessToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/v1/admin/attribute-value/1",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "v1",
                "admin",
                "attribute-value",
                "1"
              ]
            }
          }
        }
      ]
    }
  ]
}