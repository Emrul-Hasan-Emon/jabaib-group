{
  "info": {
    "name": "Jabaib API — File (feature-wise)",
    "_postman_id": "jabaib-file-collection",
    "description": "Feature-wise file handling: each feature (category, product, sku, banner, homepage, admin) owns its upload + remove endpoints through its own admin controller. Upload first, then store the returned url/path on the entity via its create/update/remove-image API.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:3000"
    },
    {
      "key": "adminAccessToken",
      "value": ""
    },
    {
      "key": "adminRefreshToken",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "Auth",
      "item": [
        {
          "name": "Admin login (sets token)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "http://localhost:3000/v1/admin/auth/login",
              "host": [
                "http://localhost:3000",
                "v1"
              ],
              "path": [
                "v1",
                "admin",
                "auth",
                "login"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"admin@jabaib.com\",\n  \"password\": \"Admin@12345\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const res = pm.response.json();",
                  "pm.collectionVariables.set('adminAccessToken', res.accessToken);",
                  "pm.collectionVariables.set('adminRefreshToken', res.refreshToken);"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "Category",
      "item": [
        {
          "name": "Upload image (then set imageUrl/imagePath)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "multipart/form-data; boundary=<computed>"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{adminAccessToken}}"
              }
            ],
            "url": {
              "raw": "http://localhost:3000/v1/admin/category/upload-image",
              "host": [
                "http://localhost:3000",
                "v1"
              ],
              "path": [
                "v1",
                "admin",
                "category",
                "upload-image"
              ]
            },
            "body": {
              "mode": "formdata",
              "formdata": [
                {
                  "key": "file",
                  "type": "file",
                  "src": []
                }
              ]
            }
          }
        },
        {
          "name": "Remove image (deletes file + clears fields)",
          "request": {
            "method": "DELETE",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{adminAccessToken}}"
              }
            ],
            "url": {
              "raw": "http://localhost:3000/v1/admin/category/1/image",
              "host": [
                "http://localhost:3000",
                "v1"
              ],
              "path": [
                "v1",
                "admin",
                "category",
                "1",
                "image"
              ]
            }
          }
        }
      ]
    },
    {
      "name": "Product",
      "item": [
        {
          "name": "Upload thumbnail (then set thumbnailUrl/thumbnailPath)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "multipart/form-data; boundary=<computed>"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{adminAccessToken}}"
              }
            ],
            "url": {
              "raw": "http://localhost:3000/v1/admin/product/upload-image",
              "host": [
                "http://localhost:3000",
                "v1"
              ],
              "path": [
                "v1",
                "admin",
                "product",
                "upload-image"
              ]
            },
            "body": {
              "mode": "formdata",
              "formdata": [
                {
                  "key": "file",
                  "type": "file",
                  "src": []
                }
              ]
            }
          }
        },
        {
          "name": "Upload one media item (then POST /:id/media)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "multipart/form-data; boundary=<computed>"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{adminAccessToken}}"
              }
            ],
            "url": {
              "raw": "http://localhost:3000/v1/admin/product/media/upload-image",
              "host": [
                "http://localhost:3000",
                "v1"
              ],
              "path": [
                "v1",
                "admin",
                "product",
                "media",
                "upload-image"
              ]
            },
            "body": {
              "mode": "formdata",
              "formdata": [
                {
                  "key": "file",
                  "type": "file",
                  "src": []
                }
              ]
            }
          }
        },
        {
          "name": "Upload many media items at once (then POST /:id/media per file)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "multipart/form-data; boundary=<computed>"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{adminAccessToken}}"
              }
            ],
            "url": {
              "raw": "http://localhost:3000/v1/admin/product/media/upload-many",
              "host": [
                "http://localhost:3000",
                "v1"
              ],
              "path": [
                "v1",
                "admin",
                "product",
                "media",
                "upload-many"
              ]
            },
            "body": {
              "mode": "formdata",
              "formdata": [
                {
                  "key": "file",
                  "type": "file",
                  "src": []
                }
              ]
            }
          }
        },
        {
          "name": "Reorder media gallery (order = full list of media ids)",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{adminAccessToken}}"
              }
            ],
            "url": {
              "raw": "http://localhost:3000/v1/admin/product/1/media/reorder",
              "host": [
                "http://localhost:3000",
                "v1"
              ],
              "path": [
                "v1",
                "admin",
                "product",
                "1",
                "media",
                "reorder"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"order\": [3, 1, 2]\n}"
            }
          }
        },
        {
          "name": "Remove thumbnail (deletes file + clears fields)",
          "request": {
            "method": "DELETE",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{adminAccessToken}}"
              }
            ],
            "url": {
              "raw": "http://localhost:3000/v1/admin/product/1/image",
              "host": [
                "http://localhost:3000",
                "v1"
              ],
              "path": [
                "v1",
                "admin",
                "product",
                "1",
                "image"
              ]
            }
          }
        }
      ]
    },
    {
      "name": "SKU",
      "item": [
        {
          "name": "Upload image (then set imageUrl/imagePath via SKU update)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "multipart/form-data; boundary=<computed>"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{adminAccessToken}}"
              }
            ],
            "url": {
              "raw": "http://localhost:3000/v1/admin/sku/upload-image",
              "host": [
                "http://localhost:3000",
                "v1"
              ],
              "path": [
                "v1",
                "admin",
                "sku",
                "upload-image"
              ]
            },
            "body": {
              "mode": "formdata",
              "formdata": [
                {
                  "key": "file",
                  "type": "file",
                  "src": []
                }
              ]
            }
          }
        },
        {
          "name": "Remove image (deletes file + clears fields)",
          "request": {
            "method": "DELETE",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{adminAccessToken}}"
              }
            ],
            "url": {
              "raw": "http://localhost:3000/v1/admin/sku/1/image",
              "host": [
                "http://localhost:3000",
                "v1"
              ],
              "path": [
                "v1",
                "admin",
                "sku",
                "1",
                "image"
              ]
            }
          }
        }
      ]
    },
    {
      "name": "Banner",
      "item": [
        {
          "name": "Upload image (desktop or mobile)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "multipart/form-data; boundary=<computed>"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{adminAccessToken}}"
              }
            ],
            "url": {
              "raw": "http://localhost:3000/v1/admin/banner/upload-image",
              "host": [
                "http://localhost:3000",
                "v1"
              ],
              "path": [
                "v1",
                "admin",
                "banner",
                "upload-image"
              ]
            },
            "body": {
              "mode": "formdata",
              "formdata": [
                {
                  "key": "file",
                  "type": "file",
                  "src": []
                }
              ]
            }
          }
        },
        {
          "name": "Remove desktop image",
          "request": {
            "method": "DELETE",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{adminAccessToken}}"
              }
            ],
            "url": {
              "raw": "http://localhost:3000/v1/admin/banner/1/image?kind=desktop",
              "host": [
                "http://localhost:3000",
                "v1"
              ],
              "path": [
                "v1",
                "admin",
                "banner",
                "1",
                "image"
              ],
              "query": [
                {
                  "key": "kind",
                  "value": "desktop"
                }
              ]
            }
          }
        },
        {
          "name": "Remove mobile image",
          "request": {
            "method": "DELETE",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{adminAccessToken}}"
              }
            ],
            "url": {
              "raw": "http://localhost:3000/v1/admin/banner/1/image?kind=mobile",
              "host": [
                "http://localhost:3000",
                "v1"
              ],
              "path": [
                "v1",
                "admin",
                "banner",
                "1",
                "image"
              ],
              "query": [
                {
                  "key": "kind",
                  "value": "mobile"
                }
              ]
            }
          }
        },
        {
          "name": "Remove both images",
          "request": {
            "method": "DELETE",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{adminAccessToken}}"
              }
            ],
            "url": {
              "raw": "http://localhost:3000/v1/admin/banner/1/image?kind=all",
              "host": [
                "http://localhost:3000",
                "v1"
              ],
              "path": [
                "v1",
                "admin",
                "banner",
                "1",
                "image"
              ],
              "query": [
                {
                  "key": "kind",
                  "value": "all"
                }
              ]
            }
          }
        }
      ]
    },
    {
      "name": "Homepage",
      "item": [
        {
          "name": "Upload image (then embed in content.imageUrl)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "multipart/form-data; boundary=<computed>"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{adminAccessToken}}"
              }
            ],
            "url": {
              "raw": "http://localhost:3000/v1/admin/homepage-section/upload-image",
              "host": [
                "http://localhost:3000",
                "v1"
              ],
              "path": [
                "v1",
                "admin",
                "homepage-section",
                "upload-image"
              ]
            },
            "body": {
              "mode": "formdata",
              "formdata": [
                {
                  "key": "file",
                  "type": "file",
                  "src": []
                }
              ]
            }
          }
        },
        {
          "name": "Remove image (deletes file + clears content.imageUrl)",
          "request": {
            "method": "DELETE",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{adminAccessToken}}"
              }
            ],
            "url": {
              "raw": "http://localhost:3000/v1/admin/homepage-section/1/image",
              "host": [
                "http://localhost:3000",
                "v1"
              ],
              "path": [
                "v1",
                "admin",
                "homepage-section",
                "1",
                "image"
              ]
            }
          }
        }
      ]
    },
    {
      "name": "Admin",
      "item": [
        {
          "name": "Upload avatar (then set imageUrl/imagePath)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "multipart/form-data; boundary=<computed>"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{adminAccessToken}}"
              }
            ],
            "url": {
              "raw": "http://localhost:3000/v1/admin/admin-user/upload-image",
              "host": [
                "http://localhost:3000",
                "v1"
              ],
              "path": [
                "v1",
                "admin",
                "admin-user",
                "upload-image"
              ]
            },
            "body": {
              "mode": "formdata",
              "formdata": [
                {
                  "key": "file",
                  "type": "file",
                  "src": []
                }
              ]
            }
          }
        },
        {
          "name": "Remove avatar (deletes file + clears fields)",
          "request": {
            "method": "DELETE",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{adminAccessToken}}"
              }
            ],
            "url": {
              "raw": "http://localhost:3000/v1/admin/admin-user/1/image",
              "host": [
                "http://localhost:3000",
                "v1"
              ],
              "path": [
                "v1",
                "admin",
                "admin-user",
                "1",
                "image"
              ]
            }
          }
        }
      ]
    }
  ]
}