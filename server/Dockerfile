FROM node:22-alpine AS build
WORKDIR /app
COPY package.json package-lock.json ./
RUN npm ci
COPY . .
RUN npm run build

FROM node:22-alpine AS runtime
WORKDIR /app
ENV NODE_ENV=production
COPY package.json package-lock.json ./
RUN npm ci --omit=dev
COPY --from=build /app/dist ./dist
# Local file uploads persist outside the image — mount a volume at /app/uploads.
VOLUME ["/app/uploads"]
EXPOSE 3000
CMD ["node", "dist/main.js"]
