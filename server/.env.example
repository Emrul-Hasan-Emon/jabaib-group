DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=ghl
DB_PASSWORD=unused
DB_DATABASE=jabaib
# true on managed Postgres (Neon/Supabase/Render) — their TLS chain is self-signed.
DB_SSL=false
TYPEORM_LOGGING=false

# Comma-separated allow-list, e.g. https://jabaib.vercel.app. Unset in dev => reflect any origin.
CORS_ORIGINS=

JWT_SECRET=change-me-in-production
JWT_DURATION=1d
JWT_REFRESH_DURATION=30d

# Absolute or relative path where uploaded files are stored (STORAGE_DRIVER=local only).
LOCAL_UPLOAD_DIR=./uploads

# File storage: 'local' (disk, default) or 's3' (Neon Object Storage / any
# S3-compatible bucket). The S3_*/AWS_* vars below are only read when 's3'.
STORAGE_DRIVER=local
# From Neon console > Storage tab > Reveal/Copy credentials (or `neon credentials create`).
AWS_ENDPOINT_URL_S3=
AWS_REGION=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
S3_BUCKET=jabaib

# HMAC secret for bKash/Nagad/card payment callbacks (POST /v1/payment/callback/:provider).
# Unset in dev => signature check is skipped.
PAYMENT_CALLBACK_SECRET=
